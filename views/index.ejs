<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Members Only</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <main>
    <%- include('partials/headers.ejs') %>

    <div>
      <% if (currentUser && !currentUser?.is_member) { %>
      <button onclick="">Join the club!</button>
      <% } %>

      <% if (currentUser) { %>
      <button onclick="messageModal.showModal()">Create Message</button>
      <dialog id="messageModal">
        <h2>New Message</h2>

        <form action="/createMessage" method="POST">
          <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" required>
          </div>

          <div class="form-group">
            <label for="content">Message</label>
            <textarea id="content" name="content" required></textarea>
            <input type="hidden" name="author_id" value="<%= currentUser.user_id %>">
          </div>

          <div class="actions">
            <button type="button" onclick="messageModal.close()">Cancel</button>
            <button type="submit">Post</button>
          </div>
        </form>
      </dialog>
      <% } %>
    </div>

    <div class="messagesContainer">
      <% locals.messages.forEach(msg => { %>
      <div class="messageBox">
        <div class="top">
          <p class="title"><%= msg.title %></p>
          <p class="date"><%= msg.created_at %></p>
        </div>
        <% if (currentUser?.is_member) { %>
        <p class="author"><%= msg.author_name %></p>
        <% } %>
        <p class="content"><%= msg.content %></p>
        <% if (currentUser?.is_admin) { %>
        <form action="/deleteMessage/<%= msg.message_id %>" method="post">
          <button type="submit" onclick="return confirm('Are you sure you want to delete this message?')">Delete</button>
        </form>
        <% } %>
      </div>
      <% }) %>
    </div>
  </main>
</body>

</html>